{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinpatsu-hiroin-com",
  "main": "./dist/index.js",
  "compatibility_date": "2025-03-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "character-r2",
      "preview_bucket_name": "character-r2-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinpatsu-heroine-com",
      "database_id": "9769343c-fcc7-4bf2-bcbd-8afd1dfdc891",
      "migrations_dir": "./drizzle/migrations/"
    },
    {
      "binding": "DB_PREVIEW",
      "database_name": "kinpatsu-heroine-com-preview",
      "database_id": "6e0cdc6d-1efa-4e36-9b75-ba26ef562cb2",
      "migrations_dir": "./drizzle/migrations/"
    }
  ]
}
