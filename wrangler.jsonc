{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinpatsu-heroine-com",
  "main": "./dist/index.js",
  "compatibility_date": "2025-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "character-r2",
      "preview_bucket_name": "character-r2-preview"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinpatsu-heroine-com",
      "database_id": "7bf200e2-7a47-4760-976c-75d1ecdd1437",
      "migrations_dir": "./drizzle/migrations/"
    }
  ],
  "observability": {
    "enabled": true
  }
}
