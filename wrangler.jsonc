{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinpatsu-hiroin-com",
  "main": "./dist/index.js",
  "compatibility_date": "2025-03-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "character-r2",
      "preview_bucket_name": "character-r2-preview"
    }
  ]
}
