{
  "name": "kinpatsu-hiroin.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build && cp ./.assetsignore ./dist",
    "preview": "wrangler dev",
    "preview:remote": "vite build --mode client && vite build && cp ./.assetsignore ./dist && wrangler dev --remote",
    "deploy": "npm run build && wrangler deploy",
    "lint": "biome lint ./src && biome lint ./app",
    "lint:fix": "biome lint --write ./src && biome lint --write ./app",
    "format": "biome format ./src && biome format ./app"
  },
  "private": true,
  "dependencies": {
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.41.0",
    "graphql": "^16.10.0",
    "graphql-request": "^7.1.2",
    "hono": "^4.7.6",
    "honox": "^0.1.40",
    "inversify": "^7.5.0",
    "neverthrow": "^8.2.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/workers-types": "^4.20250413.0",
    "@hono/vite-build": "^1.6.0",
    "@hono/vite-dev-server": "^0.18.3",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.14.1",
    "drizzle-kit": "^0.30.6",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.19.3",
    "vite": "^6.2.6",
    "wrangler": "^3.114.5"
  }
}
