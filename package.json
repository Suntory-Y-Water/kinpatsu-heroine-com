{
  "name": "kinpatsu-hiroin.com",
  "type": "module",
  "version": "1.0.4",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build --mode client && vite build && cp ./.assetsignore ./dist",
    "preview": "wrangler dev",
    "preview:remote": "vite build --mode client && vite build && cp ./.assetsignore ./dist && wrangler dev --remote",
    "deploy": "chmod +x deploy.sh && ./deploy.sh",
    "deploy:with-vars": "chmod +x deploy-with-vars.sh && ./deploy-with-vars.sh",
    "tail": "wrangler tail",
    "lint": "biome lint ./app",
    "lint:fix": "biome lint --write ./app",
    "format": "biome format ./app",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --dir test-unit",
    "test:integration": "vitest run --config ./test-integration/vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:local": "tsx scripts/migrate.ts local latest",
    "db:local:all": "tsx scripts/migrate.ts local all",
    "typegen": "wrangler types"
  },
  "private": true,
  "dependencies": {
    "@hono/zod-validator": "^0.7.0",
    "bcrypt": "^6.0.0",
    "bcrypt-ts": "^7.1.0",
    "cheerio": "^1.1.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.2",
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "hono": "^4.8.3",
    "hono-pino": "^0.8.0",
    "honox": "^0.1.42",
    "neverthrow": "^8.2.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/vitest-pool-workers": "^0.8.47",
    "@cloudflare/workers-types": "^4.20250627.0",
    "@hono/vite-build": "^1.6.2",
    "@hono/vite-dev-server": "^0.20.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.15.33",
    "drizzle-kit": "^0.31.4",
    "happy-dom": "^17.6.3",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "~3.2.4",
    "wrangler": "^4.22.0"
  }
}
