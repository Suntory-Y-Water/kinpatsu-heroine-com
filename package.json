{
  "name": "kinpatsu-hiroin.com",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build --mode client && vite build && cp ./.assetsignore ./dist",
    "preview": "wrangler dev",
    "preview:remote": "vite build --mode client && vite build && cp ./.assetsignore ./dist && wrangler dev --remote",
    "deploy": "npm run build && wrangler deploy",
    "lint": "biome lint ./src && biome lint ./app",
    "lint:fix": "biome lint --write ./src && biome lint --write ./app",
    "format": "biome format ./src && biome format ./app",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:local": "tsx scripts/migrate.ts local latest",
    "db:preview": "tsx scripts/migrate.ts preview latest --remote",
    "db:prod": "tsx scripts/migrate.ts production latest --remote",
    "db:all": "pnpm run db:local && pnpm run db:preview && pnpm run db:prod"
  },
  "private": true,
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.41.0",
    "graphql": "^16.10.0",
    "graphql-request": "^7.1.2",
    "hono": "^4.7.7",
    "honox": "^0.1.40",
    "inversify": "^7.5.1",
    "neverthrow": "^8.2.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/workers-types": "^4.20250420.0",
    "@hono/vite-build": "^1.6.0",
    "@hono/vite-dev-server": "^0.18.3",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.14.1",
    "drizzle-kit": "^0.30.6",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.3",
    "vite": "^6.3.2",
    "wrangler": "^4.12.0"
  }
}
