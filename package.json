{
  "name": "kinpatsu-hiroin.com",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build --mode client && vite build && cp ./.assetsignore ./dist",
    "preview": "wrangler dev",
    "preview:remote": "vite build --mode client && vite build && cp ./.assetsignore ./dist && wrangler dev --remote",
    "deploy": "chmod +x deploy.sh && ./deploy.sh",
    "deploy:with-vars": "chmod +x deploy-with-vars.sh && ./deploy-with-vars.sh",
    "tail": "wrangler tail",
    "lint": "biome lint ./app",
    "lint:fix": "biome lint --write ./app",
    "format": "biome format ./app",
    "test": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:local": "tsx scripts/migrate.ts local latest",
    "db:local:all": "tsx scripts/migrate.ts local all"
  },
  "private": true,
  "dependencies": {
    "@hono/zod-validator": "^0.5.0",
    "bcrypt": "^6.0.0",
    "bcrypt-ts": "^7.0.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.43.1",
    "graphql": "^16.11.0",
    "graphql-request": "^7.1.2",
    "hono": "^4.7.10",
    "hono-pino": "^0.8.0",
    "honox": "^0.1.40",
    "neverthrow": "^8.2.0",
    "zod": "^3.25.6"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/workers-types": "^4.20250519.0",
    "@hono/vite-build": "^1.6.1",
    "@hono/vite-dev-server": "^0.19.0",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.15.19",
    "drizzle-kit": "^0.31.1",
    "happy-dom": "^17.4.7",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.4",
    "wrangler": "^4.15.2"
  }
}
