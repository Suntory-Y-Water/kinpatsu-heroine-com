{
  "name": "kinpatsu-hiroin.com",
  "type": "module",
  "version": "1.0.7",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build --mode client && vite build && cp ./.assetsignore ./dist",
    "preview": "wrangler dev",
    "preview:remote": "vite build --mode client && vite build && cp ./.assetsignore ./dist && wrangler dev --remote",
    "deploy": "chmod +x deploy.sh && ./deploy.sh",
    "deploy:with-vars": "chmod +x deploy-with-vars.sh && ./deploy-with-vars.sh",
    "tail": "wrangler tail",
    "lint": "biome lint ./app",
    "lint:fix": "biome lint --write ./app",
    "format": "biome format ./app",
    "test": "pnpm test:unit && pnpm test:it",
    "test:unit": "vitest run --dir test-unit",
    "test:it": "vitest run --config ./test-integration/vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:local": "tsx scripts/migrate.ts local latest",
    "db:local:all": "tsx scripts/migrate.ts local all",
    "typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "ai-check": "pnpm run lint && pnpm run typecheck"
  },
  "private": true,
  "dependencies": {
    "@hono/zod-validator": "^0.7.4",
    "bcrypt-ts": "^7.1.0",
    "cheerio": "^1.1.2",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "graphql": "^16.12.0",
    "graphql-request": "^7.3.1",
    "hono": "^4.10.4",
    "hono-pino": "^0.10.3",
    "honox": "^0.1.52",
    "neverthrow": "^8.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/vitest-pool-workers": "^0.10.3",
    "@cloudflare/workers-types": "^4.20251014.0",
    "@hono/vite-build": "^1.7.0",
    "@hono/vite-dev-server": "^0.23.0",
    "@libsql/client": "^0.15.15",
    "@tailwindcss/vite": "^4.1.16",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.18.13",
    "drizzle-kit": "^0.31.6",
    "happy-dom": "^17.6.3",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "vite": "^6.4.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "~3.2.4",
    "wrangler": "^4.45.3"
  }
}
